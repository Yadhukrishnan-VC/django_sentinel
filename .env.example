# DjangoSentinel Environment Configuration
# Copy this file to .env and fill in your API keys

# AI Provider Settings (choose one ANTHROPIC_API_KEY, or OPENAI_API_KEY, or GOOGLE_API_KEY)
# Only one AI provider is needed at a time
# ANTHROPIC_API_KEY=your_anthropic_key_here
GOOGLE_API_KEY=your_google_key_here

# GitHub Integration (for PR comments, check runs, inline annotations)
GITHUB_TOKEN=your_github_personal_token_here
GITHUB_REPOSITORY=your_github_username/your_repo_name
GITHUB_SHA=your_git_commit_sha
GITHUB_REF=refs/pull/123/merge  # optional, for PR-aware scanning


HARDCODED_SECRET=test
SENTINEL_AI_PROVIDER=gemini

# Docker: folder to scan (default: current folder)
# SCAN_PATH=/path/to/your/django/project

# Scan Settings
# --min-confidence: Minimum confidence threshold (0.0-1.0), default 0.0
# --fail-on: Exit code 1 if findings at this severity or above exist
# --format: Output format (terminal, json, html, sarif)
# --fix: Auto-fix safe vulnerabilities
# --fix --ai: Auto-fix + AI for complex issues
# --ai: Enable AI-powered fixes and explanations
# --ai-deep: Run AI pattern scanner on every file
# --diff: Scan only changed lines (git diff)
# --staged: With --diff: scan staged changes only
